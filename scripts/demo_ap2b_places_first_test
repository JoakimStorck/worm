from dataclasses import dataclass
import random
import matplotlib.pyplot as plt

# --- Dataklasser ---
@dataclass
class Place:
    place_id: int
    x: float
    y: float
    place_type: str  # 'residence' eller 'workplace'
    municipality_id: str = None

@dataclass
class Workplace:
    workplace_id: int
    place_id: int
    sni_code: str

@dataclass
class Individual:
    individual_id: int
    residence_place_id: int
    workplace_id: int = None  # None = arbetslös

# --- Demo: Skapa platser ---
places = []
for i in range(10):
    if i < 6:
        places.append(Place(place_id=i, x=random.uniform(0, 10), y=random.uniform(0, 10), place_type="residence", municipality_id="2081"))
    else:
        places.append(Place(place_id=i, x=random.uniform(0, 10), y=random.uniform(0, 10), place_type="workplace", municipality_id="2081"))

# --- Demo: Skapa arbetsplatser, kopplade till platser ---
workplaces = [
    Workplace(workplace_id=1, place_id=6, sni_code="56100"),
    Workplace(workplace_id=2, place_id=7, sni_code="62010"),
    Workplace(workplace_id=3, place_id=8, sni_code="86101"),
]

# --- Demo: Skapa individer ---
individuals = [
    Individual(individual_id=1, residence_place_id=0, workplace_id=1),
    Individual(individual_id=2, residence_place_id=1, workplace_id=2),
    Individual(individual_id=3, residence_place_id=2, workplace_id=3),
    Individual(individual_id=4, residence_place_id=3, workplace_id=None),  # Arbetslös
]

# --- Skriv ut resultat ---
print("PLACES:")
for p in places:
    print(p)
print("\nWORKPLACES:")
for w in workplaces:
    print(w)
print("\nINDIVIDUALS:")
for i in individuals:
    print(i)

# --- Plotta på karta (matplotlib) ---
plt.figure(figsize=(6,6))
for p in places:
    if p.place_type == "residence":
        plt.scatter(p.x, p.y, color="blue", marker="o", label="Bostad" if p.place_id == 0 else "")
    else:
        plt.scatter(p.x, p.y, color="red", marker="s", label="Arbetsplats" if p.place_id == 6 else "")

# Rita linjer: hem → jobb (för de med jobb)
for ind in individuals:
    if ind.workplace_id is not None:
        home = next(pl for pl in places if pl.place_id == ind.residence_place_id)
        wp = next(w for w in workplaces if w.workplace_id == ind.workplace_id)
        job = next(pl for pl in places if pl.place_id == wp.place_id)
        plt.plot([home.x, job.x], [home.y, job.y], "k--", alpha=0.6)

plt.xlabel("X")
plt.ylabel("Y")
plt.legend()
plt.title("Bostäder (blå cirkel), Arbetsplatser (röd fyrkant), Pendling (streck)")
plt.show()
